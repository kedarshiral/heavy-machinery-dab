          {
            "name": "severity",
            "expr": "severity"
          },
          {
            "name": "fault_ts",
            "expr": "fault_ts"
          }
        ],
        "measures": [
          {
            "name": "fault_count",
            "expr": "COUNT(1)"
          }
        ]
      }
    },
    {
      "name": "fact_maintenance_event",
      "displayName": "Maintenance Event Facts",
      "config": {
        "version": "1.1",
        "source": "main.gold.fact_maintenance_event",
        "dimensions": [
          {
            "name": "machine_sk",
            "expr": "machine_sk"
          },
          {
            "name": "date_sk",
            "expr": "date_sk"
          },
          {
            "name": "maint_type",
            "expr": "maint_type"
          }
        ],
        "measures": [
          {
            "name": "maint_count",
            "expr": "COUNT(1)"
          },
          {
            "name": "total_maint_cost",
            "expr": "SUM(maint_cost)"
          },
          {
            "name": "avg_days_since_maint",
            "expr": "AVG(days_since_last_maintenance)"
          }
        ]
      }
    },
    {
      "name": "kpi_maintenance_urgency",
      "displayName": "Maintenance Urgency KPI",
      "config": {
        "version": "1.1",
        "source": "main.gold.kpi_maintenance_urgency",
        "dimensions": [
          {
            "name": "machine_sk",
            "expr": "machine_sk"
          }
        ],
        "measures": [
          {
            "name": "overheat_events",
            "expr": "SUM(overheat_count)"
          },
          {
            "name": "avg_days_since_maint",
            "expr": "AVG(days_since_maint)"
          },
          {
            "name": "avg_util",
            "expr": "AVG(avg_util)"
          },
          {
            "name": "avg_urgency_score",
            "expr": "AVG(urgency_score)"
          },
          {
            "name": "max_urgency_score",
            "expr": "MAX(urgency_score)"
          }
        ]
      }
    }
