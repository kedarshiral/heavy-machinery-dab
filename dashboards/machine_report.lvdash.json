    {
      "name": "fact_utilization_daily",
      "displayName": "Daily Utilization Facts",
      "config": {
        "version": "1.1",
        "source": "main.gold.fact_utilization_daily",
        "dimensions": [
          {
            "name": "machine_sk",
            "expr": "machine_sk"
          },
          {
            "name": "date_sk",
            "expr": "date_sk"
          }
        ],
        "measures": [
          {
            "name": "active_hours",
            "expr": "SUM(active_hours)"
          },
          {
            "name": "idle_hours",
            "expr": "SUM(idle_hours)"
          },
          {
            "name": "avg_utilization_pct",
            "expr": "AVG(utilization_pct)"
          }
        ]
      }
    },
    {
      "name": "fact_telemetry_30min",
      "displayName": "Telemetry Facts (30-min)",
      "config": {
        "version": "1.1",
        "source": "main.gold.fact_telemetry_30min",
        "dimensions": [
          {
            "name": "machine_sk",
            "expr": "machine_sk"
          },
          {
            "name": "date_sk",
            "expr": "date_sk"
          },
          {
            "name": "time_bucket_sk",
            "expr": "time_bucket_sk"
          },
          {
            "name": "time_bucket_30m",
            "expr": "time_bucket_30m"
          }
        ],
        "measures": [
          {
            "name": "avg_temp",
            "expr": "AVG(avg_temp)"
          },
          {
            "name": "max_temp",
            "expr": "MAX(max_temp)"
          },
          {
            "name": "avg_press",
            "expr": "AVG(avg_press)"
          },
          {
            "name": "avg_fuel",
            "expr": "AVG(avg_fuel)"
          },
          {
            "name": "avg_rpm",
            "expr": "AVG(avg_rpm)"
          },
          {
            "name": "total_readings",
            "expr": "SUM(readings)"
          }
        ]
      }
    },
    {
      "name": "dim_time_30min",
      "displayName": "Time Bucket Dimension (30 min)",
      "config": {
        "version": "1.1",
        "source": "main.gold.dim_time_30min",
        "dimensions": [
          {
            "name": "time_bucket_sk",
            "expr": "time_bucket_sk"
          },
          {
            "name": "time_start",
            "expr": "time_start"
          },
          {
            "name": "time_end",
            "expr": "time_end"
          }
        ]
      }
    },
    {
      "name": "fact_fault_event",
      "displayName": "Fault Event Facts",
      "config": {
        "version": "1.1",
        "source": "main.gold.fact_fault_event",
        "dimensions": [
          {
            "name": "machine_sk",
            "expr": "machine_sk"
          },
          {
            "name": "date_sk",
            "expr": "date_sk"
