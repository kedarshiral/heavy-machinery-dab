{
  "datasets": [
    {
      "name": "dim_machine",
      "displayName": "Machine Dimension",
      "config": {
        "source": "main.gold.dim_machine",
        "measures": [
          {
            "name": "machine_count",
            "expr": "COUNT(1)"
          },
          {
            "name": "total_book_value",
            "expr": "SUM(book_value)"
          }
        ],
        "filter": "__CURRENT = true",
        "version": "1.1",
        "dimensions": [
          {
            "name": "machine_sk",
            "expr": "machine_sk"
          },
          {
            "name": "machine_id",
            "expr": "machine_id"
          },
          {
            "name": "model_id",
            "expr": "model_id"
          },
          {
            "name": "owner_id",
            "expr": "owner_id"
          },
          {
            "name": "site_id",
            "expr": "site_id"
          },
          {
            "name": "status",
            "expr": "status"
          },
          {
            "name": "asset_class",
            "expr": "asset_class"
          },
          {
            "name": "manufacture_year",
            "expr": "manufacture_year"
          },
          {
            "name": "has_sap_asset",
            "expr": "has_sap_asset"
          }
        ]
      }
    },
    {
